# ---------------------------------------------------------------------------
# Kinnred backend — environment contract
#
# Every variable here is validated at boot by src/config/env.schema.ts.
# The app REFUSES TO START if any required value is missing or malformed —
# that is deliberate. A backend that boots with a missing secret and fails
# later, in a request path that handles location or KYC data, is worse than
# one that never boots.
#
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Browser origins allowed to call the API, comma-separated. Only browser
# clients need this — native apps do not enforce CORS.
#
# Leave BLANK in development: it falls back to the Expo web dev origins
# (localhost and 127.0.0.1 on ports 8081 and 19006), which is what
# `npx expo start --web` in mobile/ serves from.
#
# It does NOT fall back in production. Blank there allows no browser origin at
# all, which is the right answer for a mobile-only deployment. Set it only once
# a real web client exists, and list exact origins — "*" is rejected at boot.
CORS_ORIGINS=

# --- Database --------------------------------------------------------------
# Local dev: the Docker container from docker-compose.yml (D-014).
#
# Port 5433, not 5432 — the compose stack deliberately avoids the default so it
# cannot collide with any Postgres already installed on the host. The password
# below is the throwaway one defined in docker-compose.yml, not a real secret.
#
# The `schema` param is required by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/kinnred?schema=public"

# --- Redis -----------------------------------------------------------------
# Local dev: the Docker container on 6380 (again offset from the 6379 default).
# Production: leave REDIS_PASSWORD set. Empty is fine for the local container.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# --- Queue -----------------------------------------------------------------
# Prefix keeps BullMQ keys namespaced so a shared Redis (or a dev machine
# running several projects) cannot collide.
QUEUE_PREFIX=kinnred

# --- Auth (S1) -------------------------------------------------------------
# REQUIRED, no default, minimum 32 chars. Deliberately has no fallback: a
# signing key with a built-in default means every deployment that forgets to
# set it shares one key, and anyone reading the source can mint tokens for any
# user. Generate a real one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Access tokens cannot be revoked, so keep the window short.
JWT_ACCESS_TTL=15m
# Refresh tokens are revocable (tracked as families in the database).
JWT_REFRESH_TTL=30d

# OTP lifetime and guess budget. 6 digits with 5 attempts in 5 minutes is what
# makes brute force infeasible — do not loosen these without thinking it through.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# SMS cost-abuse control. Without a per-phone cap, one script can bill you for
# unlimited messages.
OTP_MAX_PER_PHONE_PER_HOUR=3

# --- Object storage (S2) ---------------------------------------------------
# Cloudflare R2 today. Named STORAGE_* rather than R2_* because R2 is
# S3-compatible: switching to AWS S3 or a local MinIO is an endpoint +
# credential change, with no code change (D-026).
#
# R2 endpoint format:  https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   (Account ID is on the R2 overview page in the Cloudflare dashboard.)
STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto

# TWO buckets with TWO separately-scoped API tokens (CLAUDE.md §2.4).
# In Cloudflare: R2 > Manage API Tokens > Create API Token > Object Read & Write,
# and use "Specify bucket" to scope each token to exactly one bucket.
#
# The separation is the point: a leaked media token must not be able to reach
# biometric ID documents. Do not reuse one credential for both.
STORAGE_MEDIA_BUCKET=kinnred-media
STORAGE_MEDIA_ACCESS_KEY_ID=
STORAGE_MEDIA_SECRET_ACCESS_KEY=

STORAGE_KYC_BUCKET=kinnred-kyc
STORAGE_KYC_ACCESS_KEY_ID=
STORAGE_KYC_SECRET_ACCESS_KEY=

# Presigned READ URLs are capped at 5 minutes: the URL is a bearer capability
# that keeps working until it expires, even if the owner blocks the viewer or
# re-locks their photos in the meantime.
STORAGE_READ_TTL_SECONDS=300

# Uploads get longer — a phone on a bad connection needs time — but bounded.
STORAGE_UPLOAD_TTL_SECONDS=900

# 10 MB. Enforced in the presigned URL AND re-checked against the real object
# by the worker; the client is never trusted about size.
MEDIA_MAX_UPLOAD_BYTES=10485760

# --- Verification / KYC (S4) -------------------------------------------------
# Which KYC adapter to use. The vendor is still undecided (CLAUDE.md §6).
# The mock is fully functional for development and REFUSES TO CONSTRUCT when
# NODE_ENV=production, so it cannot be left on by accident — a mock KYC
# provider in production lets anyone grant themselves verified status.
KYC_PROVIDER=mock

# HMAC secret for inbound provider webhooks, and (as a stopgap) the admin
# token on the manual decision endpoint. Minimum 32 characters, no default —
# same reasoning as JWT_SECRET. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KYC_WEBHOOK_SECRET=

# How long a PENDING verification may wait before the hourly sweep expires it.
# Generous, because real vendors take hours for manual review. The sweep is not
# housekeeping: one live attempt is allowed per user, so without it a dropped
# webhook locks that user out of verification permanently.
KYC_REQUEST_TTL_HOURS=72

# --- Pings (S5) --------------------------------------------------------------
# New outbound pings per user per rolling day.
#
# The harassment control on the 1:1 surface. Unlike OTP there is no per-message
# cost to us, so this exists purely to bound how many strangers one account can
# contact. Counted in Redis, so it holds across API instances.
#
# Only NEW connections count — accepting a request or replying in an open
# thread does not consume the budget.
PING_MAX_PER_DAY=30

# =============================================================================
# Grid (S7)
# =============================================================================

# Seed for the per-user location offset (CLAUDE.md §2.2). REQUIRED, no default.
#
# This is the secret that makes location fuzzing worth anything: the offset is
# HMAC(this salt, userId), so anyone who learns it can recompute every user's
# displacement and subtract it, turning the public fuzzed point straight back
# into an exact position. Treat it exactly like JWT_SECRET.
#
#   openssl rand -base64 48
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#
# Rotating it re-fuzzes each user on their NEXT location write — stored offsets
# are not backfilled. Rotate slowly and rarely: every rotation hands a patient
# observer a second independent sample of the same person, which is the
# averaging attack the determinism exists to prevent.
GRID_LOCATION_SALT=replace-me-with-48-random-bytes-at-least-32-chars

# Bounds of the displacement, in meters. Drawn deterministically from this
# range per user, then fixed for that user.
GRID_FUZZ_MIN_METERS=100
GRID_FUZZ_MAX_METERS=300

# Write debounce (CLAUDE.md §4). A location write persists only if the user has
# moved further than this OR this many seconds have elapsed. Deliberately below
# the fuzz radius: movement smaller than the offset is not observable through
# the Grid at all, so persisting it buys nothing and costs a row version, index
# churn and WAL. This is the single cheapest thing protecting Postgres.
GRID_DEBOUNCE_METERS=100
GRID_DEBOUNCE_SECONDS=60

# How recently a location must have been written for its owner to count as
# "online". Must stay above GRID_DEBOUNCE_SECONDS or active users flicker
# offline between two persisted writes (boot-time check enforces this).
GRID_ONLINE_WINDOW_SECONDS=300
