# Generated dependencies, local state and secrets never belong in build uploads.
**/node_modules/
**/.expo/
**/.git/
**/.claude/
**/.idea/
**/.vscode/
**/dist/
**/coverage/
**/*.log
**/.env
**/.env.*
!**/.env.example
# Generate portable native projects on EAS instead of uploading local SDK paths.
/mobile/android/
/mobile/ios/
/backend/
/deploy/
*.md
