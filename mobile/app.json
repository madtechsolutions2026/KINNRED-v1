{
  "expo": {
    "name": "Kinnred",
    "slug": "kinnred",
    "scheme": "kinnred",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.kinnred.mobile"
    },
    "android": {
      "package": "app.kinnred.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FF5A16",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kinnred needs access to your photos so you can add them to your profile.",
          "cameraPermission": "Kinnred needs camera access so you can take a profile photo."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Kinnred uses your location to show people near you. Your exact position is never shown to anyone."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ed6b2a18-7707-4f60-9b7f-00f9cd586ad8"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ed6b2a18-7707-4f60-9b7f-00f9cd586ad8"
    }
  }
}
